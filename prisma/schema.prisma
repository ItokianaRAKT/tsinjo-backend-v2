generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  USER
  MERCHANT
  ADMIN
}

enum FoodCategory {
  BOULANGERIE          // Pain, viennoiseries, pâtisseries
  PLATS_CUISINES       // Plats préparés, traiteur, fast-food
  FRUITS_ET_LEGUMES    // Produits frais du marché / primeur
  PRODUITS_LAITIERS    // Yaourts, lait, fromage, beurre
  VIANDES_ET_POISSONS  // Boucherie, charcuterie, poissonnerie
  EPICERIE_SECHE       // Riz, pâtes, biscuits, céréales
  CONSERVES            // Boîtes de conserve, bocaux
  BOISSONS             // Jus, sodas, eau, produits laitiers liquides
  PANIER_SURPRISE      // Lot d'invendus variés
  AUTRES
}

enum OfferStatus {
  ACTIVE     // Visible sur le catalogue (quantityAvailable > 0 et pickupDeadline > now)
  SOLD_OUT   // Tous les exemplaires sont réservés (masqué, mais revient ACTIVE si annulation)
  EXPIRED    // pickupDeadline ou expirationDate dépassée
  SUSPENDED  // Compte du vendeur suspendu ou banni
}

enum ReservationStatus {
  PENDING              // Réservé, en attente de récupération
  COMPLETED            // Double validation effectuée (buyerConfirmed && creatorConfirmed)
  NO_SHOW              // Non récupéré 1h après estimatedPickupTime -> remis en stock
  CANCELLED_BY_BUYER   // Annulé par l'acheteur -> +1 consecutiveCancellations + remis en stock
  CANCELLED_BY_CREATOR // Annulé par le vendeur -> +1 creatorCancellationCount
}

enum ReportReason {
  EXPIRED_PRODUCT      // Produit déjà périmé / impropre à la consommation
  FAKE_IMAGE           // Photo non réelle / prise sur internet
  SCAM_OR_NO_SHOW      // Arnaque ou vendeur absent
  FREQUENT_CANCELLER   // Vendeur qui annule trop souvent ses offres
  INAPPROPRIATE        // Contenu ou commentaire offensant
  OTHER
}

enum ReportStatus {
  UNDER_REVIEW
  REJECTED
  ACCEPTED
}

// ==================== MODELS ====================

model User {
  id                       String             @id @default(uuid())
  email                    String?            @unique
  phone                    String             @unique
  isPhoneVerified          Boolean            @default(false)
  passwordHash             String
  fullName                 String
  role                     Role               @default(USER)

  // Sanctions, pénalités & modération admin
  consecutiveCancellations Int                @default(0) // Reset à 0 si COMPLETED ou après sanction
  creatorCancellationCount Int                @default(0) // Pénalise la mise en avant dans le catalogue
  acceptedReportsCount     Int                @default(0) // 3 -> 7j, 5 -> 14j, 6 -> ban définitif
  suspensionCount          Int                @default(0) // Nb de suspensions subies pour no-show
  suspendedUntil           DateTime?
  isPermanentlyBanned      Boolean            @default(false)
  isManuallyBlocked        Boolean            @default(false)
  blockReason              String?
  deletedAt                DateTime?          // Soft delete

  // Relations
  phoneVerification        PhoneVerification?
  merchant                 Merchant?
  offers                   Offer[]            @relation("CreatedOffers")
  reservations             Reservation[]
  reviews                  Review[]
  reviewReplies            ReviewReply[]
  reviewVotes              ReviewVote[]
  refreshTokens            RefreshToken[]
  reportsCreated           Report[]           @relation("Reporter")
  reportsReceived          Report[]           @relation("ReportedUser")

  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

model PhoneVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  code      String   @unique // Code à 6 caractères (ex: A8F9K2)
  expiresAt DateTime // Création + 10 minutes
  createdAt DateTime @default(now())
}

model PhoneCooldown {
  id             String   @id @default(uuid())
  phone          String   @unique
  reason         String   // "ACCOUNT_DELETED" ou "PERMANENT_BAN"
  availableAfter DateTime // Date de suppression/ban + 60 jours (2 mois)
  createdAt      DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Merchant {
  id            String   @id @default(uuid())
  ownerId       String   @unique
  owner         User     @relation(fields: [ownerId], references: [id])
  businessName  String
  description   String?
  address       String   // Obligatoire
  quartier      String
  latitude      Float
  longitude     Float
  isVerified    Boolean  @default(false)

  // Note globale mise à jour à chaque nouvel avis
  averageRating Float    @default(0)
  reviewCount   Int      @default(0)

  offers        Offer[]
  reviews       Review[] @relation("MerchantReviews")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Offer {
  id                String        @id @default(uuid())
  creatorId         String
  creator           User          @relation("CreatedOffers", fields: [creatorId], references: [id])
  merchantId        String?
  merchant          Merchant?     @relation(fields: [merchantId], references: [id])

  title             String
  description       String?
  category          FoodCategory
  images            OfferImage[]  // Au moins 1 photo réelle exigée côté DTO

  originalPrice     Int?          // Uniquement pour les marchands (% de solde)
  price             Int           // Peut être 0 si don par un particulier
  quantityAvailable Int           @default(1)

  address           String
  quartier          String?
  latitude          Float
  longitude         Float

  expirationDate    DateTime      // DLC (Date Limite de Consommation)
  pickupDeadline    DateTime      // Date et heure limite de récupération (< expirationDate)
  status            OfferStatus   @default(ACTIVE)

  reservations      Reservation[]
  reviews           Review[]      @relation("OfferReviews")
  reports           Report[]      @relation("ReportedOffer")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, category])
  @@index([expirationDate])
  @@index([pickupDeadline])
  @@index([latitude, longitude])
}

model OfferImage {
  id        String   @id @default(uuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  url       String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Reservation {
  id                  String            @id @default(uuid())
  buyerId             String
  buyer               User              @relation(fields: [buyerId], references: [id])
  offerId             String
  offer               Offer             @relation(fields: [offerId], references: [id])

  quantity            Int               @default(1)
  estimatedPickupTime DateTime          // Heure approximative indiquée par l'acheteur (+1h -> NO_SHOW)

  // Double validation de récupération
  buyerConfirmed      Boolean           @default(false)
  creatorConfirmed    Boolean           @default(false)

  status              ReservationStatus @default(PENDING)
  review              Review?           // 1 seul avis possible par réservation complétée

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, estimatedPickupTime])
}

model Review {
  id            String       @id @default(uuid())
  authorId      String
  author        User         @relation(fields: [authorId], references: [id])
  reservationId String       @unique // Garantit qu'on ne peut noter qu'après une commande COMPLETED
  reservation   Reservation  @relation(fields: [reservationId], references: [id])

  // L'avis cible soit l'offre, soit le marchand
  offerId       String?
  offer         Offer?       @relation("OfferReviews", fields: [offerId], references: [id])
  merchantId    String?
  merchant      Merchant?    @relation("MerchantReviews", fields: [merchantId], references: [id])

  rating        Int          // Note de 1 à 5
  comment       String?

  reply         ReviewReply? // Relation 1-to-1 : garantit une seule réponse du marchand
  votes         ReviewVote[]
  reports       Report[]     @relation("ReportedReview")

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String   @unique // Empêche techniquement une 2ème réponse
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String   // Le marchand concerné
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model ReviewVote {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isHelpful Boolean  // true = like, false = dislike

  @@unique([reviewId, userId]) // Un seul vote par utilisateur et par avis
}

model Report {
  id             String       @id @default(uuid())
  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])

  // Cible du signalement (une seule des trois est remplie)
  offerId        String?
  offer          Offer?       @relation("ReportedOffer", fields: [offerId], references: [id], onDelete: Cascade)
  reviewId       String?
  review         Review?      @relation("ReportedReview", fields: [reviewId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  reason         ReportReason
  details        String?
  status         ReportStatus @default(UNDER_REVIEW)
  adminNote      String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Un rapporteur ne peut signaler qu'une fois la même cible.
  @@unique([reporterId, offerId])
  @@unique([reporterId, reviewId])
  @@unique([reporterId, reportedUserId])
}
