# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tsinjo

# JWT secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated list of allowed browser origins (empty = deny in production)
CORS_ORIGIN=http://localhost:5173

# Shared secret expected in the X-Webhook-Secret header of POST /auth/verify-phone-webhook
SMS_WEBHOOK_SECRET=
